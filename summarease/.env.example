VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_FEEDBACK_EMAIL=your_email@gmail.com

# Optional: public URL of your app used for auth redirects (password reset, magic links, etc.)
# Example (local network): http://192.168.1.50:5173
# Example (production): https://yourdomain.com
VITE_PUBLIC_SITE_URL=

# Polar.sh Configuration (for frontend)
# Get these from https://polar.sh/dashboard
VITE_POLAR_ORGANIZATION_ID=your_polar_organization_id
VITE_POLAR_PRODUCT_ID=your_polar_product_id
# Direct checkout link (create from Polar dashboard -> Checkout Links)
VITE_POLAR_CHECKOUT_LINK=https://buy.polar.sh/polar_cl_YOUR_CHECKOUT_ID
